# Local dev — not committed (see .gitignore). Use a strong password in production.

DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

PORT=3002
NODE_ENV=development
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=true

# Match your Next.js origin if you use the signup form locally
CORS_ORIGIN=http://localhost:3000

# Optional — enables Supabase Auth (Dashboard → Project Settings → API)
# Without these keys, signup uses local password auth against Postgres.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key

# Used for local auth JWT tokens when Supabase keys are not set
JWT_SECRET=uber-chef-local-dev-secret

# Flutterwave (pricing checkout → merchant account)
# Get keys from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
PUBLIC_WEB_URL=http://localhost:3000
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_ENV=sandbox
FLUTTERWAVE_CURRENCY=NGN
